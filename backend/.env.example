PROJECT_NAME="AI Resume Builder API"
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars!

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_builder
REDIS_URL=redis://localhost:6379/0

# JWT Auth
JWT_SECRET_KEY=change-this-to-a-super-secret-jwt-key-min-32-chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LinkedIn OAuth 2.0 / OIDC (Scopes: openid profile email)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
LINKEDIN_AUTH_URL=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
FRONTEND_URL=http://localhost:3000

# AI Model
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
